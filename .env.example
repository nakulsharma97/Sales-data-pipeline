# MySQL configuration example
# Copy this file to .env and fill in your real credentials.
# Never commit .env to git (it is already in .gitignore).

MYSQL_ROOT_PASSWORD=secretroot
MYSQL_USER=retail_user
MYSQL_PASSWORD=secretpass
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=retail_demo

# Optional: full URI override (takes precedence over the parts above)
# MYSQL_URI=mysql+pymysql://retail_user:secretpass@localhost:3306/retail_demo
